VITE_APP_NAME="PalmTrack"
VITE_API_URL=http://localhost:8000/api

# Peta Kebun (Mapbox GL). Token publik ("pk.") dari akun Mapbox kamu sendiri —
# https://account.mapbox.com/access-tokens/. Dibiarkan kosong di demo publik
# GitHub Pages supaya traffic pengunjung tidak memakai kuota 50rb/bulan; isi
# ini hanya di .env.local untuk development, atau saat deploy ke pelanggan asli.
VITE_MAPBOX_TOKEN=
