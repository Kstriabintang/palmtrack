VITE_APP_NAME="PalmTrack"
VITE_API_URL=http://localhost:8000/api

# Peta Kebun (Mapbox GL). Token publik ("pk.") dari akun Mapbox kamu sendiri —
# https://account.mapbox.com/access-tokens/. Isi ini di .env.local untuk
# development. Untuk demo publik di GitHub Pages, token disuntikkan lewat
# GitHub Actions secret "MAPBOX_TOKEN" saat build (lihat .github/workflows/deploy.yml)
# — jangan taruh token asli di file ini atau di file yang ter-commit.
VITE_MAPBOX_TOKEN=
